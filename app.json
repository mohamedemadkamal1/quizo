{
  "expo": {
    "name": "Mr. Quizo",
    "slug": "quizo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "quizo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./src/assets/images/icon.png",
      "bundleIdentifier": "com.amergroup.quizo",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/adaptive-icon.png",
        "backgroundColor": "#06142B"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.amergroup.quizo"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Fredoka",
                "fontDefinitions": [
                  {
                    "path": "node_modules/@expo-google-fonts/fredoka/400Regular/Fredoka_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/fredoka/500Medium/Fredoka_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/fredoka/600SemiBold/Fredoka_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/fredoka/700Bold/Fredoka_700Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "Nunito",
                "fontDefinitions": [
                  {
                    "path": "node_modules/@expo-google-fonts/nunito/500Medium/Nunito_500Medium.ttf",
                    "weight": 500
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "node_modules/@expo-google-fonts/fredoka/400Regular/Fredoka_400Regular.ttf",
              "node_modules/@expo-google-fonts/fredoka/500Medium/Fredoka_500Medium.ttf",
              "node_modules/@expo-google-fonts/fredoka/600SemiBold/Fredoka_600SemiBold.ttf",
              "node_modules/@expo-google-fonts/fredoka/700Bold/Fredoka_700Bold.ttf",
              "node_modules/@expo-google-fonts/nunito/500Medium/Nunito_500Medium.ttf"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./src/assets/images/splash/white-splash.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "./plugins/with-react-native-view-recycling-workaround",
      "expo-image",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": ["en", "ar"],
          "supportsRTL": true
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a717a2eb-128a-4a26-8690-eee707b61ed7"
      }
    }
  }
}
